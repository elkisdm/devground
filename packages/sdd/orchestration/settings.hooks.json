{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/orchestrator-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/orchestrator-gate.sh",
            "statusMessage": "Verificando regla de orquestaci\u00f3n"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/delegacion-gate.py",
            "statusMessage": "Verificando delegaci\u00f3n (ADR-0049)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/delegacion-medicion.py --hook"
          }
        ]
      }
    ]
  }
}
